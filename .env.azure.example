# ==============================================================================
# CONFIGURACIÓN CLOUD AZURE (northcentralus - Azure for Students) - LAB 03
# ==============================================================================
# Plantilla contractual para despliegue en Azure Container Apps / Key Vault

ENV=dev
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# PUERTOS Y PERÍMETRO EN AZURE CONTAINER APPS
# Cada contenedor expone el puerto estándar 8080 dentro de snet-aca
# ------------------------------------------------------------------------------
PORT=8080
GATEWAY_PORT=8080
AUTH_PORT=8080
PERSON_PORT=8080
ACADEMIC_PORT=8080
ENROLLMENT_PORT=8080
FINANCE_PORT=8080
LIBRARY_PORT=8080
LMS_PORT=8080

# ------------------------------------------------------------------------------
# BASES DE DATOS RELACIONALES (Azure Database for MySQL Flexible Server)
# Conectividad segura vía Private Endpoint / Private DNS Zone
# ------------------------------------------------------------------------------
DB_HOST=privatelink.mysql.database.azure.com
DB_PORT=3306
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=5m
DB_CONN_MAX_IDLE_TIME=2m

# Nombres de bases de datos lógicas (Single Server, Multi-Logical DB)
AUTH_DB_NAME=auth_db
AUTH_DB_USER=auth_user
# Las contraseñas se resuelven en runtime desde Azure Key Vault o Secret Store de ACA
AUTH_DB_PASSWORD=@Microsoft.KeyVault(SecretUri=https://kv-univ-dev-ncus.vault.azure.net/secrets/db-auth-user-pwd/)

PERSON_DB_NAME=person_db
PERSON_DB_USER=person_user
PERSON_DB_PASSWORD=@Microsoft.KeyVault(SecretUri=https://kv-univ-dev-ncus.vault.azure.net/secrets/db-person-user-pwd/)

ACADEMIC_DB_NAME=academic_db
ACADEMIC_DB_USER=academic_user
ACADEMIC_DB_PASSWORD=@Microsoft.KeyVault(SecretUri=https://kv-univ-dev-ncus.vault.azure.net/secrets/db-academic-user-pwd/)

ENROLLMENT_DB_NAME=enrollment_db
ENROLLMENT_DB_USER=enrollment_user
ENROLLMENT_DB_PASSWORD=@Microsoft.KeyVault(SecretUri=https://kv-univ-dev-ncus.vault.azure.net/secrets/db-enrollment-user-pwd/)

FINANCE_DB_NAME=finance_db
FINANCE_DB_USER=finance_user
FINANCE_DB_PASSWORD=@Microsoft.KeyVault(SecretUri=https://kv-univ-dev-ncus.vault.azure.net/secrets/db-finance-user-pwd/)

# ------------------------------------------------------------------------------
# PERSISTENCIA NOSQL DOCUMENTAL (Azure Cosmos DB NoSQL API - Free Tier)
# ------------------------------------------------------------------------------
NOSQL_ENDPOINT=https://cosmos-univ-dev-ncus.documents.azure.com:443/
NOSQL_USE_MANAGED_IDENTITY=true
NOSQL_KEY=
NOSQL_REGION=northcentralus

LIBRARY_NOSQL_DB=library_db
LMS_NOSQL_DB=lms_db

# ------------------------------------------------------------------------------
# MENSAJERÍA Y EVENTOS (Azure Service Bus Standard con RBAC Data-Plane)
# ------------------------------------------------------------------------------
EVENT_BUS_TYPE=azure_servicebus
SERVICEBUS_FQDN=sb-univ-dev-ncus.servicebus.windows.net
SERVICEBUS_CONNECTION_STRING=

# Caché interno en Container Apps (Ahorro FinOps vs Managed Redis)
REDIS_ADDR=ca-redis:6379
REDIS_PASSWORD=
REDIS_DB=0

# ------------------------------------------------------------------------------
# SEGURIDAD, PERÍMETRO Y GOBERNANZA ZERO-TRUST
# ------------------------------------------------------------------------------
JWT_ISSUER=https://api.universidad.edu.pe/api/v1/auth
JWKS_URL=http://auth-service:8080/.well-known/jwks.json
KEYVAULT_URI=https://kv-univ-dev-ncus.vault.azure.net/
