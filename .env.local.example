# ==============================================================================
# CONFIGURACIÓN LOCAL DOCKER COMPOSE ($0.00) - LAB 03
# ==============================================================================
# Copiar este archivo a .env para desarrollo local:
#   cp .env.local.example .env

ENV=local
LOG_LEVEL=DEBUG

# ------------------------------------------------------------------------------
# PUERTOS Y PERÍMETRO (HOST & RED INTERNA DOCKER)
# ------------------------------------------------------------------------------
GATEWAY_PORT=8080
AUTH_PORT=8081
PERSON_PORT=8082
ACADEMIC_PORT=8083
ENROLLMENT_PORT=8084
FINANCE_PORT=8085
LIBRARY_PORT=8086
LMS_PORT=8087

# ------------------------------------------------------------------------------
# BASES DE DATOS RELACIONALES (MySQL 8.4 en Docker Compose)
# Contenedor expone 3306 en red interna docker y 3307 hacia host (evita colisiones)
# ------------------------------------------------------------------------------
DB_HOST=mysql
DB_PORT=3306
DB_ROOT_PASSWORD=RootSecretLocal2026!
DB_MAX_OPEN_CONNS=10
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=5m
DB_CONN_MAX_IDLE_TIME=2m

# Credenciales segregadas por servicio (DML)
AUTH_DB_NAME=auth_db
AUTH_DB_USER=auth_user
AUTH_DB_PASSWORD=AuthUserSecret2026!

PERSON_DB_NAME=person_db
PERSON_DB_USER=person_user
PERSON_DB_PASSWORD=PersonUserSecret2026!

ACADEMIC_DB_NAME=academic_db
ACADEMIC_DB_USER=academic_user
ACADEMIC_DB_PASSWORD=AcademicUserSecret2026!

ENROLLMENT_DB_NAME=enrollment_db
ENROLLMENT_DB_USER=enrollment_user
ENROLLMENT_DB_PASSWORD=EnrollmentUserSecret2026!

FINANCE_DB_NAME=finance_db
FINANCE_DB_USER=finance_user
FINANCE_DB_PASSWORD=FinanceUserSecret2026!

# ------------------------------------------------------------------------------
# PERSISTENCIA NOSQL DOCUMENTAL (DynamoDB Local Emulado)
# ------------------------------------------------------------------------------
NOSQL_ENDPOINT=http://dynamodb-local:8000
NOSQL_KEY=dummyKeyLocal123
NOSQL_REGION=us-east-1
NOSQL_USE_MANAGED_IDENTITY=false

LIBRARY_NOSQL_DB=library_db
LMS_NOSQL_DB=lms_db

# ------------------------------------------------------------------------------
# MENSAJERÍA, EVENTOS (EDA) Y CACHÉ DISTRIBUIDO (Redis Streams en Docker)
# ------------------------------------------------------------------------------
EVENT_BUS_TYPE=local_redis
REDIS_ADDR=redis:6379
REDIS_PASSWORD=
REDIS_DB=0

# Variables Azure Service Bus vacías en local
SERVICEBUS_FQDN=
SERVICEBUS_CONNECTION_STRING=

# ------------------------------------------------------------------------------
# IDENTIDAD Y SEGURIDAD JWT (RS256 / JWKS)
# ------------------------------------------------------------------------------
JWT_ISSUER=http://localhost:8080/api/v1/auth
JWKS_URL=http://auth-service:8081/.well-known/jwks.json
KEYVAULT_URI=

# ------------------------------------------------------------------------------
# PORTAL ESTUDIANTIL WEB SPA (React 18 + Vite + Nginx) Y CORS PERIMETRAL
# ------------------------------------------------------------------------------
WEB_PORT=3000
VITE_API_BASE_URL=http://localhost:8080
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

